{
  "catalog_version": "1.0",
  "purpose": "WorkflowPad Music Studio Basic caption builder, app-side deterministic composition; no LLM call needed",
  "important": "ACE-Step 1.5 caption uses free-form text, not an official closed list of allowable enum values. Documented examples are not guarantees; curated entries are music terms to try.",
  "source_urls": [
    "https://github.com/ace-step/ACE-Step-1.5/blob/main/docs/en/Tutorial.md",
    "https://github.com/ace-step/ACE-Step-1.5/blob/main/docs/en/ace_step_musicians_guide.md",
    "https://huggingface.co/spaces/ACE-Step/Ace-Step-v1.5/blob/2b1ad1c0b68bb8bce2c0dc77ad224c35a274f7ee/INFERENCE.md"
  ],
  "behavior": {
    "compose_mode": "selected English phrases joined by comma and single space, in category order; no translation, no paraphrase, no AI rewrite",
    "caption_field_note": "reference inference guide lists a 512-character max; verify the currently installed ComfyUI node and keep length indicator plus warning",
    "metadata_separate": [
      "bpm",
      "keyscale",
      "timesignature",
      "duration",
      "vocal_language"
    ],
    "ai_recommend": "separate explicitly invoked action; never automatically called when Basic options change",
    "preset_behavior": "preset sets selectors, then remains fully editable",
    "conflict_policy": "show local rule-based warnings, do not silently remove selected phrases",
    "state": "store stable item IDs and custom phrase strings per song, preserve Basic and Advanced values independently",
    "source_label": "official_example_or_close means a close matching term is represented in the official docs; not officially enumerated and not guaranteed"
  },
